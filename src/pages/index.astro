const skills = [
  'PHP', 'Laravel', 'JavaScript', 'Node.js',
  'PostgreSQL', 'MySQL', 'Oracle', 'REST APIs', 'Git', 'Docker',
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lucas Schuster — Backend Dev</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap');

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #020818;
        color: #a5c8ff;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        overflow-x: hidden;
      }

      /* Matrix canvas */
      #matrix {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        z-index: 0;
        opacity: 0.07;
        pointer-events: none;
      }

      /* Scanlines overlay */
      body::after {
        content: '';
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(99, 179, 237, 0.015) 2px,
          rgba(99, 179, 237, 0.015) 4px
        );
        pointer-events: none;
        z-index: 9999;
      }

      .content { position: relative; z-index: 1; }

      /* Glitch effect */
      .glitch {
        position: relative;
        animation: glitch-skew 4s infinite linear alternate-reverse;
      }
      .glitch::before,
      .glitch::after {
        content: attr(data-text);
        position: absolute;
        top: 0; left: 0;
        width: 100%;
        height: 100%;
      }
      .glitch::before {
        color: #0ff;
        animation: glitch-anim 3s infinite linear alternate-reverse;
        clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
        transform: translate(-3px, 0);
        opacity: 0.6;
      }
      .glitch::after {
        color: #818cf8;
        animation: glitch-anim2 2.5s infinite linear alternate-reverse;
        clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
        transform: translate(3px, 0);
        opacity: 0.6;
      }
      @keyframes glitch-anim {
        0%   { clip-path: polygon(0 2%, 100% 2%, 100% 5%, 0 5%); transform: translate(-3px, 0); }
        20%  { clip-path: polygon(0 15%, 100% 15%, 100% 15%, 0 15%); transform: translate(3px, 0); }
        40%  { clip-path: polygon(0 44%, 100% 44%, 100% 46%, 0 46%); transform: translate(-3px, 0); }
        60%  { clip-path: polygon(0 50%, 100% 50%, 100% 20%, 0 20%); transform: translate(3px, 0); }
        80%  { clip-path: polygon(0 70%, 100% 70%, 100% 75%, 0 75%); transform: translate(-3px, 0); }
        100% { clip-path: polygon(0 90%, 100% 90%, 100% 94%, 0 94%); transform: translate(3px, 0); }
      }
      @keyframes glitch-anim2 {
        0%   { clip-path: polygon(0 60%, 100% 60%, 100% 65%, 0 65%); transform: translate(3px, 0); }
        25%  { clip-path: polygon(0 30%, 100% 30%, 100% 35%, 0 35%); transform: translate(-3px, 0); }
        50%  { clip-path: polygon(0 80%, 100% 80%, 100% 85%, 0 85%); transform: translate(3px, 0); }
        75%  { clip-path: polygon(0 10%, 100% 10%, 100% 15%, 0 15%); transform: translate(-3px, 0); }
        100% { clip-path: polygon(0 50%, 100% 50%, 100% 55%, 0 55%); transform: translate(3px, 0); }
      }
      @keyframes glitch-skew {
        0%   { transform: skew(0deg); }
        10%  { transform: skew(-1deg); }
        20%  { transform: skew(0deg); }
        80%  { transform: skew(0deg); }
        90%  { transform: skew(1deg); }
        100% { transform: skew(0deg); }
      }

      /* Blink cursor */
      .cursor::after {
        content: '█';
        animation: blink 1s step-end infinite;
        color: #60a5fa;
      }
      @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

      /* Terminal box */
      .terminal {
        background: rgba(2, 8, 24, 0.9);
        border: 1px solid #1e3a5f;
        border-radius: 6px;
        box-shadow: 0 0 24px rgba(59, 130, 246, 0.12), inset 0 0 20px rgba(0,0,0,0.5);
      }
      .terminal-header {
        background: rgba(59, 130, 246, 0.06);
        border-bottom: 1px solid #1e3a5f;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .dot { width: 10px; height: 10px; border-radius: 50%; }

      /* Glow text */
      .glow { text-shadow: 0 0 10px rgba(59, 130, 246, 0.8), 0 0 20px rgba(59, 130, 246, 0.4); }

      /* Nav link hover */
      .nav-link {
        color: #3b82f6;
        transition: color 0.2s, text-shadow 0.2s;
        text-decoration: none;
      }
      .nav-link:hover { color: #93c5fd; text-shadow: 0 0 8px rgba(59, 130, 246, 0.8); }

      /* Btn primary */
      .btn-primary {
        display: inline-flex; align-items: center; gap: 8px;
        background: transparent;
        border: 1px solid #3b82f6;
        color: #60a5fa;
        padding: 10px 22px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        position: relative;
        overflow: hidden;
        z-index: 0;
      }
      .btn-primary::before {
        content: '';
        position: absolute; inset: 0;
        background: #3b82f6;
        transform: translateX(-100%);
        transition: transform 0.2s;
        z-index: -1;
      }
      .btn-primary:hover { color: #020818; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); }
      .btn-primary:hover::before { transform: translateX(0); }

      .btn-ghost {
        display: inline-flex; align-items: center; gap: 8px;
        background: transparent;
        border: 1px solid #1e3a5f;
        color: #3b82f6;
        padding: 10px 22px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
      }
      .btn-ghost:hover { border-color: #60a5fa; color: #93c5fd; }

      /* Section */
      section { padding: 80px 0; border-top: 1px solid rgba(59, 130, 246, 0.1); }

      /* Typewriter */
      #typewriter { color: #60a5fa; }

      /* Scroll fade-in */
      .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; }
      .fade-in.visible { opacity: 1; transform: translateY(0); }
    </style>
  </head>
